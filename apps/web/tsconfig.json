{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    // Vite owns the build; tsc is only a typechecker here.
    "noEmit": true,

    // `vite-plugin-pwa/client` declares the `virtual:pwa-register` module the service
    // worker registration imports. Without it that import is an unresolved module.
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],

  // The service worker is checked by `tsconfig.sw.json` instead. `lib.dom` and
  // `lib.webworker` declare incompatible versions of the same globals — `self` above all —
  // so a file that needs the worker types cannot share a program with the app.
  "exclude": ["src/sw.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    // Vite owns the build; tsc is only a typechecker here.
    "noEmit": true,

    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}

# Keeps the build context small and, more importantly, keeps secrets out of it. A .env
# copied into a layer stays in the image even if a later layer deletes it.
.env
.env.*
!.env.example

node_modules
**/node_modules
**/dist
**/coverage
**/.turbo
**/*.tsbuildinfo

.git
.github
.vscode
docs

# Regenerated inside the image by `prisma generate`. Copying a host-built client risks
# shipping one compiled against a different schema than the migrations in the image.
apps/api/src/generated

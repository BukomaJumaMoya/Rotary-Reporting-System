{
  "name": "@dis/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and shared types. The single source of truth for every request and response shape.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}

# Rotaract DIS — environment variables
#
# Copy to .env and fill in for local development:   cp .env.example .env
#
# .env is gitignored and must stay that way. NEVER put a real secret, connection
# string or API key in THIS file — it is committed. Staging and production values live
# in the hosting platform's secret store, under the DISTRICT-owned account with two
# administrators (ADR-011), never in a personal account and never on a laptop.
#
# Variables are listed here as the design commits to them; each becomes required as
# the milestone that uses it lands, at which point it is added to the Zod schema in
# apps/api/src/platform/config.ts. Only the variables marked [M0] are read today.

# ─── Core ────────────────────────────────────────────────────────────────────────
NODE_ENV=development                    # [M0] development | test | production
PORT=4000                               # [M0] API HTTP port
LOG_LEVEL=info                          # trace | debug | info | warn | error
WEB_ORIGIN=http://localhost:5173        # Browser origin, for CORS and cookie config
# [M0] Reverse proxies in front of the API. 0 locally; 1 behind Fly/Railway. Too low and
# every request looks like it came from the load balancer, so the login rate limiter
# throttles all members as one client; too high and a caller can forge X-Forwarded-For.
TRUST_PROXY_HOPS=0

# ─── Database (ADR-001) ──────────────────────────────────────────────────────────
# Pooled connection for the app; direct connection for migrations, which cannot run
# through a transaction pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rotaract_dis
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rotaract_dis
# Prisma replays migration history here to detect drift. Created and dropped on demand;
# must never point at a database holding real data.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rotaract_dis_shadow
# [M0] Integration tests TRUNCATE every table between cases, so the name must contain
# "test" — the vitest global setup refuses to run otherwise.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dis_test
# Never point a development environment at production. Use npm run db:seed.

# ─── Sessions and authentication (ADR-003) ───────────────────────────────────────
SESSION_SECRET=change-me-32-bytes-minimum   # Generate: openssl rand -base64 32
SESSION_COOKIE_NAME=dis.sid
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                     # MUST be true in staging and production
ARGON2_MEMORY_KIB=19456                 # Argon2id parameters (OWASP baseline)
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_RATE_MAX_ATTEMPTS=5               # Per IP + email
LOGIN_RATE_WINDOW_MINUTES=15
LOCKOUT_BASE_MINUTES=5                  # Exponential backoff after repeated failures
LOCKOUT_MAX_MINUTES=1440
TOKEN_TTL_MINUTES=60                    # [M0] Password reset tokens
INVITE_TTL_MINUTES=10080                # [M0] Invitations — 7 days; officers do not
                                        # all check email daily
PRIVACY_POLICY_VERSION=2027-07-01       # Recorded on every DATA_PROCESSING consent
# [M0] Base of every link the system emails. Built from configuration and NEVER from a
# request header: Host and X-Forwarded-Host are attacker-controlled, and a reset link
# built from them can be aimed at somebody else's server.
APP_BASE_URL=http://localhost:5173

# ─── Object storage (ADR-007) ────────────────────────────────────────────────────
# S3-compatible: Cloudflare R2 or Backblaze B2. The application filesystem is never
# used for uploads — it does not survive redeployment.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=rotaract-dis-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true                # true for MinIO locally, false for R2
S3_PUBLIC_BASE_URL=http://localhost:9000/rotaract-dis-dev   # CDN base for public media
SIGNED_URL_TTL_SECONDS=300              # Short-lived URLs for private documents
UPLOAD_MAX_BYTES=10485760               # 10 MB per file
IMAGE_THUMBNAIL_PX=400                  # List images; keep the mobile budget in mind
IMAGE_DISPLAY_PX=1200
# EXIF is stripped from every uploaded image regardless of these settings.

# ─── Notifications ───────────────────────────────────────────────────────────────
# [M0] smtp delivers · log prints to the console without sending (development)
#      capture keeps messages in memory (tests only)
MAIL_TRANSPORT=log
MAIL_FROM="Rotaract District 9218 <noreply@example.org>"
SMTP_HOST=localhost
SMTP_PORT=1025                          # Mailpit / MailHog locally; 587 with a provider
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false                       # true for implicit TLS on 465
SMTP_REQUIRE_TLS=true                    # Require the STARTTLS upgrade on port 587.
                                        # Set false ONLY for a local catch-all such as
                                        # Mailpit, which offers no TLS at all.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=

# ─── Background jobs (ADR-008) ───────────────────────────────────────────────────
PGBOSS_SCHEMA=pgboss                    # pg-boss lives in the same database
WORKER_CONCURRENCY=2
JOBS_ENABLED=true                       # Set false to run the API without a worker

# ─── Web client (Vite) ───────────────────────────────────────────────────────────
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret here —
# anything with this prefix is shipped to every user.
VITE_API_BASE_URL=/api/v1
